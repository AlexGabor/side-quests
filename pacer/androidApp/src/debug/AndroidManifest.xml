<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Exported so that `adb shell am start` can reach it: the shell user does not hold
          START_ANY_ACTIVITY, so a non-exported activity cannot be launched from a terminal. Living
          in src/debug is what keeps that out of the shipped manifest.
        -->
        <activity
            android:name="com.alexgabor.pacer.icon.IconExportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true" />
    </application>

</manifest>
